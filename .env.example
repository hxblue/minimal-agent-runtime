# OpenAI-compatible LLM endpoint. The service must support structured tool calls.
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=
LLM_API_KEY=
LLM_CONNECT_TIMEOUT_SECONDS=10
LLM_READ_TIMEOUT_SECONDS=60
LLM_TEMPERATURE=0

# Agent Runtime
AGENT_DATABASE_PATH=data/agent.db
AGENT_MAX_ROUNDS=6
AGENT_CONTEXT_BUDGET=12000
AGENT_COMPRESSION_THRESHOLD=0.75
AGENT_RECENT_TURNS=4

